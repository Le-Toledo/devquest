{
  "expo": {
    "name": "CodeQuest Academy",
    "slug": "codequest-academy",
    "version": "1.0.5",
    "icon": "./assets/Designer.png",
    "orientation": "portrait",
    "scheme": "codequestacademy",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080A0F",
    "splash": {
      "backgroundColor": "#07111f",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leandrotoledo.codequest",
      "buildNumber": "8"
    },
    "android": {
      "package": "com.leandrotoledo.codequest",
      "versionCode": 8
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
